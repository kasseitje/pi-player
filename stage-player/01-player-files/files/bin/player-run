#!/bin/bash
# mpv launcher. Kept out of the unit file so playback options can be tuned in
# /etc/default/player without editing systemd units.
set -uo pipefail

. /etc/default/player

# Build the playlist before mpv starts, so a stick already inserted at power-on
# is picked up on the first frame rather than after a reload.
player-playlist || true

exec /usr/bin/mpv \
    --fullscreen \
    --loop-playlist=inf \
    --image-display-duration="$IMAGE_DURATION" \
    --idle=yes \
    --keep-open=no \
    --no-osc \
    --no-osd-bar \
    --osd-level=0 \
    --cursor-autohide=always \
    --no-input-default-bindings \
    --input-ipc-server="$MPV_SOCKET" \
    --msg-level=all=warn \
    ${MPV_OSD_OPTS:-} \
    $MPV_VO_OPTS \
    $MPV_EXTRA_OPTS \
    --playlist="$PLAYLIST"
