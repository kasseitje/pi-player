[Unit]
Description=Looping media player (mpv on bare DRM/KMS)
Documentation=man:mpv(1)
After=systemd-user-sessions.service multi-user.target
# tty1 is ours: nothing else may hold DRM master on the console.
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video render input

# A real VT plus a logind session is what grants DRM master. Without both,
# mpv fails with "VT_GETMODE: Inappropriate ioctl" / "Failed to acquire DRM master".
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

RuntimeDirectory=player
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart

ExecStart=/usr/local/bin/player-run

Restart=always
RestartSec=2
# Never give up: this box is unattended.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
